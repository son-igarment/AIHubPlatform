APP_NAME=AIHubPlatform
SECRET_KEY=change-this-secret
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
LOG_DIR=logs
LOG_LEVEL=INFO

# Automation scheduler
AUTOMATION_ENABLED=true
AUTOMATION_INTERVAL_HOURS=6
AUTOMATION_RUN_AT_STARTUP=true

# AI crawl/update pipeline
AI_CRAWL_ENDPOINT=https://api.example.com/ai/crawl
AI_CRAWL_METHOD=POST
AI_CRAWL_PAYLOAD={"refresh":true}
AI_UPDATE_ENDPOINT=https://api.example.com/ai/update
AI_UPDATE_METHOD=POST
AI_UPDATE_PAYLOAD={"sync":true}
AI_HTTP_TIMEOUT=120
AI_API_KEY=your-crawl-service-token
AI_EXTRA_HEADERS={"X-Tenant":"demo"}

# OpenAI generation
OPENAI_API_KEY=your-openai-key
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=1800
AI_CACHE_TTL_SECONDS=600
AI_CACHE_MAX=32

# Embeddings / knowledge base
KNOWLEDGE_DB_PATH=aihub_knowledge.db
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=384

# Telegram notifications
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=123456789
TELEGRAM_THREAD_ID=
TELEGRAM_PARSE_MODE=Markdown
TELEGRAM_DISABLE_NOTIFICATIONS=false
TELEGRAM_TIMEOUT=15
